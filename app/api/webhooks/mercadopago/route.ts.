import { NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-helpers'; // ou a sua instância do Supabase

export async function POST(request: Request) {
  try {
    const url = new URL(request.url);
    const topic = url.searchParams.get('topic') || url.searchParams.get('type');
    const id = url.searchParams.get('id') || url.searchParams.get('data.id');

    const body = await request.json().catch(() => ({}));
    const paymentId = id || body?.data?.id;

    if (paymentId && (topic === 'payment' || body?.type === 'payment')) {
      // 1. Consulta o status do pagamento no Mercado Pago
      const response = await fetch(`https://api.mercadopago.com/v1/payments/${paymentId}`, {
        headers: {
          Authorization: `Bearer ${process.env.MERCADOPAGO_ACCESS_TOKEN}`,
        },
      });

      if (response.ok) {
        const paymentData = await response.json();
        const status = paymentData.status; // ex: 'approved'
        const externalReference = paymentData.external_reference; // ID do pedido no Supabase

        if (externalReference) {
          // 2. Atualiza o status do pedido no Supabase
          /* 
          Exemplo com cliente Supabase:
          await supabase
            .from('orders')
            .update({ status: status })
            .eq('id', externalReference);
          */
          console.log(`Pagamento ${paymentId} para o pedido ${externalReference} atualizado para ${status}`);
        }
      }
    }

    return NextResponse.json({ status: 'ok' }, { status: 200 });
  } catch (error) {
    console.error('Erro no webhook:', error);
    return NextResponse.json({ error: 'Webhook processing failed' }, { status: 500 });
  }
}
